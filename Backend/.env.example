# =============================================================================
# Agent Arena Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Hindsight Cloud (required — hackathon sponsor) ---
# Sign up: https://ui.hindsight.vectorize.io
# Apply promo MEMHACK6 in billing for $50 credit
# Create a bank/collection named "agent-arena-ci"
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_COLLECTION_ID=agent-arena-ci
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# --- Groq LLM (required) ---
# Sign up: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- GitHub (optional — raises rate limit from 60 to 5000 req/hr) ---
# Create read-only PAT: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- CORS — comma-separated frontend origins ---
# Local dev + your deployed Lovable/frontend URL
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000

# --- Scheduler (optional overrides) ---
COLLECT_INTERVAL_MINUTES=60
